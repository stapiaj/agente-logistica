# Copia este archivo como .env y rellena los valores. Nunca subas .env a GitHub.

# Fase 1
GEMINI_API_KEY=
# Nombre de un modelo Flash disponible en el plan gratuito (consultar en Google AI Studio)
GEMINI_MODEL=
# Fase 2 (opcional): modelo de respaldo si el principal da 5xx (p. ej. 503 por saturación)
GEMINI_FALLBACK_MODEL=

# Fase 3
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Fase 4
WEBHOOK_SECRET=
