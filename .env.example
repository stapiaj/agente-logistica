# Copia este archivo como .env y rellena los valores. Nunca subas .env a GitHub.

# Fase 1
GEMINI_API_KEY=
# Nombre de un modelo Flash disponible en el plan gratuito (consultar en Google AI Studio)
GEMINI_MODEL=
# Fase 2 (opcional): modelos de respaldo, en orden y separados por comas, si el
# principal da 5xx (saturado) o 429 (cuota agotada). Ej.: gemini-3.8-flash,gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=

# Fase 3
# Fase 3a: de dónde lee el agente envíos y clientes y dónde escribe el log.
# memory = datos de app/mock_data.py (pruebas rápidas, sin cuota de API)
# sheets = la Google Sheet de GOOGLE_SHEET_ID, con la cuenta de servicio
DATA_SOURCE=memory
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# Fase 3b: emails al cliente.
# simulated = solo se imprimen (no sale nada) · resend = envío real con Resend
EMAIL_MODE=simulated
# API key de Resend con permiso "Sending access" (no "Full access")
RESEND_API_KEY=
# Remitente de pruebas de Resend (sin dominio propio)
EMAIL_FROM=onboarding@resend.dev
# Modo pruebas: si tiene valor, TODOS los emails van aquí (el cuerpo dice a quién
# iban). Sin dominio propio Resend solo envía al email de la cuenta: pon ese.
# Falla cerrado: con EMAIL_MODE=resend y esto vacío, el programa se para.
EMAIL_TEST_RECIPIENT=
# Solo con dominio propio y a propósito: true = permite emails a clientes reales
# (sin EMAIL_TEST_RECIPIENT). En este proyecto, siempre vacío.
EMAIL_ALLOW_REAL_RECIPIENTS=
# Fase 3b: avisos al responsable.
# simulated = solo se imprimen · telegram = mensaje real del bot
NOTIFY_MODE=simulated
# Token que da @BotFather (secreto: quien lo tiene controla el bot)
TELEGRAM_BOT_TOKEN=
# Tu chat con el bot: escríbele algo y ejecuta
# python -m app.integrations.telegram --find-chat-id
TELEGRAM_CHAT_ID=

# Fase 4
# Secreto compartido del webhook: quien avisa lo manda en la cabecera
# X-Webhook-Secret. Mínimo 32 caracteres; vacío o corto = el servidor no arranca.
# Generarlo: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
